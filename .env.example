# Salesforce MCP Server Configuration
# Copy this file to .env and fill in your credentials.
# Choose ONE auth method below.

# Auth Method A: Username + Password + Security Token
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# Auth Method B: OAuth 2.0 (Connected App)
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Shared Configuration (optional)
SF_LOGIN_URL=https://login.salesforce.com
SF_INSTANCE_URL=
SF_API_VERSION=v62.0
